generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
}

enum ChannelType {
  TEXT
  VOICE
}

// (ESM Cap.5 — Rich Domain Types) Replaces bare String to prevent invalid values
// from being inserted via raw SQL or future migrations.
enum AttachmentType {
  IMAGE
  VIDEO
  FILE
}

// (ESM Cap.5 — Domain Modelling) Per-channel roles for granular moderation.
// Global UserRole (ADMIN/USER) governs platform-wide access; this governs
// channel-scoped permissions (e.g., who can pin messages, kick members).
enum ChannelMemberRole {
  OWNER
  MODERATOR
  MEMBER
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  googleId    String    @unique
  email       String    @unique
  displayName String
  avatarUrl   String?
  role        UserRole  @default(USER)
  createdAt   DateTime  @default(now())
  messages    Message[]
  channelMembers ChannelMember[]
  dmsSent     DirectMessage[] @relation("sender")
  dmsReceived DirectMessage[] @relation("receiver")
}

model Channel {
  id          String    @id @default(cuid())
  name        String
  description String?
  type        ChannelType @default(TEXT)
  order       Int       @default(0)
  isPrivate   Boolean   @default(false)
  messages    Message[]
  members     ChannelMember[]
}

model ChannelMember {
  id        String            @id @default(cuid())
  userId    String
  channelId String
  // (ESM Cap.5) Per-channel role for moderator/owner delegation.
  // MEMBER is the safe default; OWNER is set on channel creation.
  role      ChannelMemberRole @default(MEMBER)
  createdAt DateTime          @default(now())

  user      User     @relation(fields: [userId], references: [id])
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}

model Message {
  id          String    @id @default(cuid())
  content     String?
  authorId    String
  channelId   String
  attachments Attachment[]
  createdAt   DateTime  @default(now())
  // (BSRS Cap.15 Forensics) updatedAt enables audit trail for message edits.
  updatedAt   DateTime  @updatedAt
  author      User      @relation(fields: [authorId], references: [id])
  channel     Channel   @relation(fields: [channelId], references: [id])

  @@index([channelId, createdAt, id])
}

model DirectMessage {
  id         String   @id @default(cuid())
  content    String?
  senderId   String
  receiverId String
  attachments Attachment[]
  createdAt  DateTime @default(now())
  // (BSRS Cap.15 Forensics) updatedAt enables audit trail for message edits.
  updatedAt  DateTime @updatedAt
  sender     User     @relation("sender", fields: [senderId], references: [id])
  receiver   User     @relation("receiver", fields: [receiverId], references: [id])

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, senderId, createdAt])
}

model Attachment {
  id        String         @id @default(cuid())
  url       String
  // (ESM Cap.5 — Rich Types) AttachmentType enum prevents invalid values;
  // bare String allowed 'foo' to be inserted without any DB-level constraint.
  type      AttachmentType
  fileName  String
  fileSize  Int
  mimeType  String
  messageId String?
  dmId      String?
  message   Message? @relation(fields: [messageId], references: [id])
  dm        DirectMessage? @relation(fields: [dmId], references: [id])

  @@index([messageId])
  @@index([dmId])
}
