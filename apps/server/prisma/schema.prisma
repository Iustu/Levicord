generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

enum ChannelType {
  TEXT
  VOICE
}

enum AttachmentType {
  IMAGE
  VIDEO
  FILE
}

enum ChannelMemberRole {
  OWNER
  MODERATOR
  MEMBER
}

enum ServerMemberRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum DmRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String          @id @default(cuid())
  googleId              String          @unique
  email                 String          @unique
  displayName           String
  avatarUrl             String?
  role                  UserRole        @default(USER)
  promotedById          String?
  promotedBy            User?           @relation("SuperAdminHierarchy", fields: [promotedById], references: [id])
  promotedUsers         User[]          @relation("SuperAdminHierarchy")
  createdAt             DateTime        @default(now())

  messages              Message[]
  deletedMessages       Message[]       @relation("DeletedMessages")
  channelMembers        ChannelMember[]
  dmsSent               DirectMessage[] @relation("sender")
  dmsReceived           DirectMessage[] @relation("receiver")
  dmRequestsSent        DmRequest[]     @relation("DmRequestsSent")
  dmRequestsReceived    DmRequest[]     @relation("DmRequestsReceived")

  serversOwned          Server[]        @relation("ServerOwner")
  serverMembers         ServerMember[]
  promotedServerMembers ServerMember[]  @relation("ServerMemberPromotions")
  bansGiven             ServerBan[]     @relation("BannedBy")
  bansReceived          ServerBan[]     @relation("BannedUser")
  invitesCreated        ServerInvite[]
  auditLogs             AuditLog[]
}

model Server {
  id          String         @id @default(cuid())
  name        String
  description String?
  iconUrl     String?
  ownerId     String
  owner       User           @relation("ServerOwner", fields: [ownerId], references: [id])
  channels    Channel[]
  members     ServerMember[]
  bans        ServerBan[]
  invites     ServerInvite[]
  auditLogs   AuditLog[]
  allowMemberInvites Boolean  @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([ownerId])
}

model ServerMember {
  id           String           @id @default(cuid())
  serverId     String
  userId       String
  role         ServerMemberRole @default(MEMBER)
  promotedById String?
  promotedBy   User?            @relation("ServerMemberPromotions", fields: [promotedById], references: [id])
  mutedUntil   DateTime?
  canInvite    Boolean          @default(true)
  joinedAt     DateTime         @default(now())

  server       Server           @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@index([serverId, role])
}

model ServerBan {
  id          String   @id @default(cuid())
  serverId    String
  userId      String
  reason      String?
  bannedById  String
  createdAt   DateTime @default(now())

  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user        User     @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
  bannedBy    User     @relation("BannedBy", fields: [bannedById], references: [id])

  @@unique([serverId, userId])
  @@index([serverId])
}

model ServerInvite {
  id          String    @id @default(cuid())
  code        String    @unique
  serverId    String
  createdById String
  maxUses     Int?
  uses        Int       @default(0)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  server      Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id])

  @@index([code])
  @@index([serverId])
}

model AuditLog {
  id        String   @id @default(cuid())
  serverId  String
  actorId   String
  action    String
  targetId  String?
  reason    String?
  metadata  String?
  createdAt DateTime @default(now())

  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  actor     User     @relation(fields: [actorId], references: [id])

  @@index([serverId, createdAt])
}

model Channel {
  id          String          @id @default(cuid())
  name        String
  description String?
  type        ChannelType     @default(TEXT)
  order       Int             @default(0)
  isPrivate   Boolean         @default(false)
  serverId    String?
  server      Server?         @relation(fields: [serverId], references: [id], onDelete: Cascade)
  messages    Message[]
  members     ChannelMember[]

  @@index([serverId])
}

model ChannelMember {
  id        String            @id @default(cuid())
  userId    String
  channelId String
  role      ChannelMemberRole @default(MEMBER)
  createdAt DateTime          @default(now())

  user      User              @relation(fields: [userId], references: [id])
  channel   Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}

model Message {
  id          String       @id @default(cuid())
  content     String?
  authorId    String
  channelId   String
  isDeleted   Boolean      @default(false)
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?        @relation("DeletedMessages", fields: [deletedById], references: [id])
  attachments Attachment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  author      User         @relation(fields: [authorId], references: [id])
  channel     Channel      @relation(fields: [channelId], references: [id])

  @@index([channelId, createdAt, id])
}

model DirectMessage {
  id          String       @id @default(cuid())
  content     String?
  senderId    String
  receiverId  String
  attachments Attachment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  sender      User         @relation("sender", fields: [senderId], references: [id])
  receiver    User         @relation("receiver", fields: [receiverId], references: [id])

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, senderId, createdAt])
}

model Attachment {
  id        String         @id @default(cuid())
  url       String
  type      AttachmentType
  fileName  String
  fileSize  Int
  mimeType  String
  isOneTime Boolean        @default(false)
  messageId String?
  dmId      String?
  message   Message?       @relation(fields: [messageId], references: [id])
  dm        DirectMessage? @relation(fields: [dmId], references: [id])

  @@index([messageId])
  @@index([dmId])
}

model DmRequest {
  id         String          @id @default(cuid())
  senderId   String
  receiverId String
  status     DmRequestStatus @default(PENDING)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  sender     User            @relation("DmRequestsSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User            @relation("DmRequestsReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
}
